  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Downstream",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Downstream Channels",
      "description": "Latest reading per downstream channel. Fields a channel type doesn't report (e.g. frequency for ofdm) are blank.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Locked" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "Locked", "color": "green", "index": 0 },
                      "0": { "text": "Unlocked", "color": "red", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_power_dbmv", "instant": true, "range": false, "format": "table" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_snr_db", "instant": true, "range": false, "format": "table" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_rxmer_db", "instant": true, "range": false, "format": "table" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_frequency_hz", "instant": true, "range": false, "format": "table" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_channel_width_hz", "instant": true, "range": false, "format": "table" },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_corrected_errors_total", "instant": true, "range": false, "format": "table" },
        { "refId": "G", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_uncorrected_errors_total", "instant": true, "range": false, "format": "table" },
        { "refId": "H", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "docsis_downstream_lock_status", "instant": true, "range": false, "format": "table" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "joinByField", "options": { "byField": "channel_id", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "instance": true, "job": true, "__name__": true,
              "channel_type 2": true, "channel_type 3": true, "channel_type 4": true,
              "channel_type 5": true, "channel_type 6": true, "channel_type 7": true, "channel_type 8": true,
              "modulation 2": true, "modulation 3": true, "modulation 4": true,
              "modulation 5": true, "modulation 6": true, "modulation 7": true, "modulation 8": true
            },
            "indexByName": {
              "channel_id": 0,
              "channel_type 1": 1,
              "modulation 1": 2,
              "Value #A": 3, "docsis_downstream_power_dbmv": 3,
              "Value #B": 4, "docsis_downstream_snr_db": 4,
              "Value #C": 5, "docsis_downstream_rxmer_db": 5,
              "Value #D": 6, "docsis_downstream_frequency_hz": 6,
              "Value #E": 7, "docsis_downstream_channel_width_hz": 7,
              "Value #F": 8, "docsis_downstream_corrected_errors_total": 8,
              "Value #G": 9, "docsis_downstream_uncorrected_errors_total": 9,
              "Value #H": 10, "docsis_downstream_lock_status": 10
            },
            "renameByName": {
              "channel_id": "Channel",
              "channel_type 1": "Type",
              "modulation 1": "Modulation",
              "Value #A": "Power (dBmV)", "docsis_downstream_power_dbmv": "Power (dBmV)",
              "Value #B": "SNR (dB)", "docsis_downstream_snr_db": "SNR (dB)",
              "Value #C": "RxMER (dB)", "docsis_downstream_rxmer_db": "RxMER (dB)",
              "Value #D": "Frequency (Hz)", "docsis_downstream_frequency_hz": "Frequency (Hz)",
              "Value #E": "Channel Width (Hz)", "docsis_downstream_channel_width_hz": "Channel Width (Hz)",
              "Value #F": "Corrected Errors", "docsis_downstream_corrected_errors_total": "Corrected Errors",
              "Value #G": "Uncorrected Errors", "docsis_downstream_uncorrected_errors_total": "Uncorrected Errors",
              "Value #H": "Locked", "docsis_downstream_lock_status": "Locked"
